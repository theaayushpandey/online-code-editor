# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Google sign-in: OAuth client ID from Google Cloud Console (type: Web application)
GOOGLE_CLIENT_ID=

# AI error explainer: API key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Code execution. The public Judge0 server needs no key.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
